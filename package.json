{
  "name": "libre-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Headless-first LibreLinkUp bridge and ESP32-C6 desk display",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mock-upstream": "tsx tools/mock-upstream/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start:bridge": "node dist/bridge/src/main.js",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fastify": "^5.4.0",
    "undici": "^7.14.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
